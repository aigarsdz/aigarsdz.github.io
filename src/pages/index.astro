---
import BaseLayout from '../layouts/base_layout.astro'
import Header from '../components/header.astro'
---

<BaseLayout>
	<main>
    <Header>
      <p>
        A software developer specializing in front-end web development. I prefer simplicity, efficiency and platforms' built-in
        features over chasing the latest trends of libraries and tools.
      </p>

      <p>
        I have  a long experience working in fast-paced startups, agencies with multiple clients,
        and established companies developing their own SaaS products.
      </p>
    </Header>

    <section id="skills">
      <h2>Skills</h2>

      <div class="home-section-content">
        <ul id="skill_list">
          <li>Front-end web development using <mark class="marker-highlight">HTML, CSS, JavaScript, React, and Vue.</mark></li>
          <li>Back-end development using <mark class="marker-highlight">JavaScript (Node), PHP (Laravel and WordPress), Rust and Ruby on Rails.</mark></li>
          <li><mark class="marker-highlight">Linux and Windows server</mark> administration.</li>
          <li>Working with multiple databases including <mark class="marker-highlight">MySQL, PostgreSQL, SQLite, MongoDB, and Redis.</mark></li>
        </ul>
      </div>
    </section>

    <section id="career">
      <h2>Experience</h2>

      <article class="experience home-section-content">
        <div class="date-interval">Since Aug&nbsp;2025</div>
        <div class="job-details">
          <p>DevOps Engineer/System and Newtork Administrator</p>
          <p class="worklpace"><em>State Digital Development Agency of Latvia</em></p>
        </div>
      </article>

      <article class="experience home-section-content">
        <div class="date-interval">Since Oct&nbsp;2022</div>
        <div class="job-details">
          <p>Freelance Web Developer</p>
        </div>
      </article>

      <article class="experience home-section-content">
        <div class="date-interval">
          <span>From Oct&nbsp;2017</span>
          <span>To Sept&nbsp;2022</span>
        </div>
        <div class="job-details">
          <p>Web Developer</p>
          <p class="worklpace"><em>Midis</em></p>
        </div>
      </article>

      <article class="experience home-section-content">
        <div class="date-interval">
          <span>From Feb&nbsp;2016</span>
          <span>To June&nbsp;2017</span>
        </div>
        <div class="job-details">
          <p>Web Developer</p>
          <p class="worklpace"><em>Rezbit</em></p>
        </div>
      </article>

      <article class="experience home-section-content">
        <div class="date-interval">
          <span>From Aug&nbsp;2013</span>
          <span>To Dec&nbsp;2015</span>
        </div>
        <div class="job-details">
          <p>Web Developer</p>
          <p class="worklpace"><em>Novo IT</em></p>
        </div>
      </article>
    </section>

    <section id="projects">
      <h2>Personal projects</h2>

      <div class="home-section-content">
        <ul id="project_list">
          <li><a href="https://github.com/aigarsdz/skice">Skice</a></li>
          <li><a href="https://aigars.digital/json">Tricky JSON formatter</a></li>
          <li><a href="https://github.com/aigarsdz/pastries">Pastries</a></li>
        </ul>
      </div>
    </section>
	</main>
</BaseLayout>
